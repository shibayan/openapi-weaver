<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsPackable>true</IsPackable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>OpenApiWeaver</PackageId>
    <Title>OpenApiWeaver</Title>
    <Description>Incremental Roslyn source generator for OpenAPI 3.0-3.2 that emits strongly typed C# HTTP clients at build time with no runtime code generation or reflection.</Description>
    <Authors>shibayan</Authors>
    <Copyright>Copyright (c) Tatsuro Shibamura 2026</Copyright>
    <PackageProjectUrl>https://shibayan.github.io/openapi-weaver/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/shibayan/openapi-weaver</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Release notes are published on GitHub: https://github.com/shibayan/openapi-weaver/releases/tag/v$(Version)</PackageReleaseNotes>
    <PackageTags>openapi;openapi3;source-generator;incremental-generator;roslyn;analyzer;csharp;http-client;code-generation</PackageTags>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackAnalyzerAssemblies</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
    <None Include="buildTransitive\OpenApiWeaver.props" Pack="true" PackagePath="buildTransitive\OpenApiWeaver.props" />
    <None Include="buildTransitive\OpenApiWeaver.targets" Pack="true" PackagePath="buildTransitive\OpenApiWeaver.targets" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.OpenApi" Version="3.10.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.OpenApi.YamlReader" Version="3.10.0" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="PackAnalyzerAssemblies">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(TargetPath)" PackagePath="analyzers/dotnet/cs" />
      <TfmSpecificPackageFile Include="$(OutputPath)Microsoft.OpenApi.dll" PackagePath="analyzers/dotnet/cs" />
      <TfmSpecificPackageFile Include="$(OutputPath)Microsoft.OpenApi.YamlReader.dll" PackagePath="analyzers/dotnet/cs" />
      <TfmSpecificPackageFile Include="$(OutputPath)SharpYaml.dll" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>
</Project>
