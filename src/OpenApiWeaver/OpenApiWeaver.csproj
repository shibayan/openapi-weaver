<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsPackable>true</IsPackable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>OpenApiWeaver</PackageId>
    <Description>Incremental Roslyn source generator that turns OpenAPI 3.x documents into strongly typed C# HTTP clients at build time.</Description>
    <Authors>shibayan</Authors>
    <Copyright>Copyright (c) Tatsuro Shibamura 2026</Copyright>
    <RepositoryUrl>https://github.com/shibayan/openapi-weaver</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>openapi;source-generator;roslyn;analyzer</PackageTags>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackAnalyzerAssemblies</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="buildTransitive\OpenApiWeaver.props" Pack="true" PackagePath="buildTransitive\OpenApiWeaver.props" />
    <None Include="buildTransitive\OpenApiWeaver.targets" Pack="true" PackagePath="buildTransitive\OpenApiWeaver.targets" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.OpenApi" Version="3.5.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.OpenApi.YamlReader" Version="3.5.0" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="PackAnalyzerAssemblies">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(TargetPath)" PackagePath="analyzers/dotnet/cs" />
      <TfmSpecificPackageFile Include="$(OutputPath)Microsoft.OpenApi.dll" PackagePath="analyzers/dotnet/cs" />
      <TfmSpecificPackageFile Include="$(OutputPath)Microsoft.OpenApi.YamlReader.dll" PackagePath="analyzers/dotnet/cs" />
      <TfmSpecificPackageFile Include="$(OutputPath)SharpYaml.dll" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>
</Project>
