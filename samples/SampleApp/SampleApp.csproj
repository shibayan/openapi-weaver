<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\src\OpenApiWeaver\buildTransitive\OpenApiWeaver.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>obj\Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenApiWeaver\OpenApiWeaver.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <Analyzer Include="..\..\src\OpenApiWeaver\bin\$(Configuration)\netstandard2.0\Microsoft.OpenApi.dll" />
    <Analyzer Include="..\..\src\OpenApiWeaver\bin\$(Configuration)\netstandard2.0\Microsoft.OpenApi.YamlReader.dll" />
    <Analyzer Include="..\..\src\OpenApiWeaver\bin\$(Configuration)\netstandard2.0\SharpYaml.dll" />
  </ItemGroup>

  <ItemGroup>
    <OpenApiWeaverDocument Include="openapi\api-schema.json" />
  </ItemGroup>

  <Import Project="..\..\src\OpenApiWeaver\buildTransitive\OpenApiWeaver.targets" />
</Project>
